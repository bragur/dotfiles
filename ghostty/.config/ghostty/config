# Ghostty Configuration
# See: https://ghostty.org/docs/config

# Font Configuration
font-family = "Maple Mono NF"
font-size = 14

# Theme - Catppuccin Mocha
# Background and text colors
background = #1e1e2e
foreground = #cdd6f4

# Cursor colors
cursor-color = #f5e0dc
cursor-text = #1e1e2e

# Selection colors
selection-background = #585b70
selection-foreground = #cdd6f4

# Normal colors
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de

# Bright colors
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# Window settings
window-padding-x = 8
window-padding-y = 8
window-theme = dark

# Performance
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Misc
confirm-close-surface = false
